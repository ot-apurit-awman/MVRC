{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build MVRC (Release)",
        "type": "shell",
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "${workspaceFolder}\\.vscode\\build-mvrc.ps1",
            "-Configuration",
            "Release"
        ],
        "group": "build",
        "problemMatcher": "$msCompile"
    },
    {
        "label": "Build MVRC (Debug)",
        "type": "shell",
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "${workspaceFolder}\\.vscode\\build-mvrc.ps1",
            "-Configuration",
            "Debug"
        ],
        "group": "build",
        "problemMatcher": "$msCompile"
    },
    {
        "label": "Build + Deploy MVRC (Release)",
        "type": "shell",
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "${workspaceFolder}\\.vscode\\build-mvrc.ps1",
            "-Configuration",
            "Release",
            "-Deploy"
        ],
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "problemMatcher": "$msCompile"
    },
    {
        "label": "Build + Deploy MVRC (Debug)",
        "type": "shell",
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "${workspaceFolder}\\.vscode\\build-mvrc.ps1",
            "-Configuration",
            "Debug",
            "-Deploy"
        ],
        "group": {
            "kind": "test",
            "isDefault": true
        },
        "problemMatcher": "$msCompile"
    }
]
}
